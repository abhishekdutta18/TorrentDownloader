    {
      "name": "Files & Media Streaming",
      "description": "Endpoints to inspect individual files, change priority levels, trigger threat intelligence scans, and stream video content.",
      "item": [
        {
          "name": "List Torrent Files & Security Info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Files payload contains security metadata\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(Array.isArray(jsonData)).to.be.true;",
                  "    if (jsonData.length > 0) {",
                  "        pm.expect(jsonData[0]).to.have.property('index');",
                  "        pm.expect(jsonData[0]).to.have.property('name');",
                  "        pm.expect(jsonData[0]).to.have.property('path');",
                  "        pm.expect(jsonData[0]).to.have.property('size');",
                  "        pm.expect(jsonData[0]).to.have.property('priority');",
                  "        pm.expect(jsonData[0]).to.have.property('security_status');",
                  "        pm.expect(jsonData[0]).to.have.property('sha256');",
                  "        pm.expect(jsonData[0]).to.have.property('is_risky_type');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
