        {
          "name": "HTTP 206 Partial Content Stream",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Streaming endpoint responds\", function () {",
                  "    // 200 (Full), 206 (Partial), 503 (Buffering from swarm), or 404 (File index not found)",
                  "    pm.expect([200, 206, 503, 404]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200 || pm.response.code === 206) {",
                  "    pm.test(\"Accept-Ranges header present\", function () {",
                  "        pm.expect(pm.response.headers.get('Accept-Ranges')).to.eql('bytes');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Range",
                "value": "bytes=0-1048575",
                "description": "Optional HTTP Range request to seek within the media stream."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stream/{{torrentHash}}/{{fileIndex}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stream",
                "{{torrentHash}}",
                "{{fileIndex}}"
              ]
            },
            "description": "High-throughput sequential HTTP streaming endpoint with chunked byte-range support for video and audio playback."
          },
          "response": []
        }
      ]
