    {
      "name": "Network & Swarm",
      "description": "Endpoints to inspect session statistics, piece bitfields, connected peers, and manage trackers.",
      "item": [
        {
          "name": "Get Session Statistics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
