{
  "info": {
    "_postman_id": "omniflux-rest-api-v1",
    "name": "OmniFlux REST API",
    "description": "Comprehensive Postman collection for OmniFlux — the native C++17 libtorrent and Swift BitTorrent client for macOS. Covers torrent lifecycle management, HTTP 206 byte-range streaming, file priority control, session swarm statistics, Jackett/DHT search, and real-time MalwareBazaar threat scanning.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Torrents",
      "description": "Endpoints to add, inspect, manage download state, pause, resume, stop, and delete torrents.",
      "item": [
        {
          "name": "List Active Torrents",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(Array.isArray(jsonData)).to.be.true;",
                  "    if (jsonData.length > 0) {",
                  "        pm.expect(jsonData[0]).to.have.property('hash');",
                  "        pm.expect(jsonData[0]).to.have.property('name');",
                  "        pm.expect(jsonData[0]).to.have.property('progress');",
                  "        pm.expect(jsonData[0]).to.have.property('download_speed');",
                  "        pm.expect(jsonData[0]).to.have.property('upload_speed');",
                  "        pm.expect(jsonData[0]).to.have.property('state');",
                  "        // Set first torrent hash in environment for downstream requests",
                  "        if (jsonData[0].hash) {",
                  "            pm.environment.set(\"torrentHash\", jsonData[0].hash);",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/torrents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "torrents"
              ]
            },
            "description": "Retrieves all active torrents with their progress, transfer speeds, peer counts, file lists, ETA, and download paths."
          },
          "response": []
        },
        {
          "name": "Add Torrent (Magnet or URL)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 409 (if already active)\", function () {",
                  "    pm.expect([200, 409]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Torrent added successfully with info hash\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData).to.have.property('status', 'success');",
                  "        pm.expect(jsonData).to.have.property('hash');",
                  "        if (jsonData.hash) {",
                  "            pm.environment.set(\"torrentHash\", jsonData.hash);",
                  "        }",
                  "    });",
                  "} else if (pm.response.code === 409) {",
                  "    pm.test(\"Duplicate torrent detected properly\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData).to.have.property('status', 'error');",
                  "        pm.expect(jsonData).to.have.property('message', 'Torrent already exists');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"magnet\": \"{{sampleMagnet}}\",\n  \"name\": \"Big Buck Bunny Test\",\n  \"save_path\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/torrents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "torrents"
              ]
            },
            "description": "Adds a new torrent from a magnet URI, HTTP torrent file link, or local file path."
          },
          "response": []
        },
        {
          "name": "Upload Torrent File",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 or 400 (if file payload omitted)\", function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"File uploaded and torrent registered\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData).to.have.property('status', 'success');",
                  "        pm.expect(jsonData).to.have.property('hash');",
                  "        if (jsonData.hash) {",
                  "            pm.environment.set(\"torrentHash\", jsonData.hash);",
                  "        }",
                  "    });",
                  "} else {",
                  "    pm.test(\"Handled missing file payload gracefully\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData).to.have.property('status', 'error');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "The .torrent file binary to upload."
                },
                {
                  "key": "save_path",
                  "value": "",
                  "type": "text",
                  "description": "Optional custom download directory path."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/torrents/file",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "torrents",
                "file"
              ]
            },
            "description": "Uploads and parses a raw `.torrent` file payload."
          },
          "response": []
        },
